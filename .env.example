# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).
#   cp .env.example .env && chmod 600 .env

# ---- Grafana admin ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-to-a-long-random-password
GRAFANA_ROOT_URL=http://127.0.0.1:3000

# ---- DevTrails app ----
# 127.0.0.1 keeps the site private (use an SSH tunnel). Set 0.0.0.0 only if you deliberately
# want the learning site public on EC2 (and open port 8000 in the security group).
APP_BIND=127.0.0.1
# Optional: require header X-Chaos-Token for /api/admin/chaos
CHAOS_TOKEN=

# ---- Outbound SMTP for Grafana alert emails ----
# Option A: Gmail. Needs 2FA plus an App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com:587
SMTP_USER=your.account@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM_ADDRESS=your.account@gmail.com
SMTP_FROM_NAME=DevTrails Alerts
SMTP_STARTTLS_POLICY=MandatoryStartTLS
SMTP_SKIP_VERIFY=false
# Option B: Mailtrap sandbox (test inbox): SMTP_HOST=sandbox.smtp.mailtrap.io:2525 plus the user/password from Mailtrap
# Option C: local Mailpit (docker compose --profile mailpit up -d):
#   SMTP_HOST=mailpit:1025  SMTP_USER=  SMTP_PASSWORD=  SMTP_STARTTLS_POLICY=NoStartTLS

# Where alert notifications are delivered (comma-separate several addresses)
ALERT_EMAIL_TO=oncall@example.com

PROMETHEUS_RETENTION=15d
